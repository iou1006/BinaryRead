<Window x:Class="BinaryRead.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BinaryRead"
        mc:Ignorable="d"
        Title="二进制文件查看器 (.dat)" Height="640" Width="660" MinWidth="520"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="DumpColumn" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <EventSetter Event="PreviewMouseWheel" Handler="Column_PreviewMouseWheel" />
        </Style>
        <Style x:Key="HeaderColumn" TargetType="TextBox" BasedOn="{StaticResource DumpColumn}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#EEF1F4" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SelectButton" Content="选择文件..." Padding="14,6"
                    Click="SelectButton_Click" />
            <Button x:Name="CopyButton" Content="复制本页" Padding="14,6" Margin="8,0,0,0"
                    Click="CopyButton_Click" IsEnabled="False" />
            <Button x:Name="RefreshButton" Content="刷新" Padding="14,6" Margin="8,0,0,0"
                    Click="RefreshButton_Click" IsEnabled="False" />
            <CheckBox x:Name="AutoRefreshCheck" Content="自动刷新" VerticalAlignment="Center"
                      Margin="10,0,0,0" IsEnabled="False"
                      Checked="AutoRefreshCheck_Changed" Unchecked="AutoRefreshCheck_Changed" />
            <TextBlock x:Name="FileInfoText" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="#555" Text="将 .dat 文件拖到此窗口，或点击“选择文件...”" />
        </StackPanel>

        <StackPanel x:Name="NavPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"
                    IsEnabled="False">
            <Button x:Name="PrevButton" Content="◀ 上一页" Padding="10,4" Click="PrevButton_Click" />
            <Button x:Name="NextButton" Content="下一页 ▶" Padding="10,4" Margin="6,0,0,0"
                    Click="NextButton_Click" />
            <TextBlock x:Name="PageInfoText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#555" Text="第 0 / 0 页" />
            <TextBlock Text="跳转偏移(hex):" VerticalAlignment="Center" Margin="18,0,4,0" />
            <TextBox x:Name="JumpBox" Width="120" VerticalAlignment="Center" Padding="4,3"
                     KeyDown="JumpBox_KeyDown" />
            <Button x:Name="JumpButton" Content="跳转" Padding="10,4" Margin="6,0,0,0"
                    Click="JumpButton_Click" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" Background="#FBFBFB">
            <ScrollViewer x:Name="HScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColOffset" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColSep1" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColHex" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColSep2" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColAscii" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource HeaderColumn}"
                                 Foreground="#0066AA" Text="Offset" />
                        <Rectangle Grid.Column="1" Width="1" Fill="#D0D0D0" VerticalAlignment="Stretch" />
                        <TextBox Grid.Column="2" Style="{StaticResource HeaderColumn}"
                                 Text="00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F" />
                        <Rectangle Grid.Column="3" Width="1" Fill="#D0D0D0" VerticalAlignment="Stretch" />
                        <TextBox Grid.Column="4" Style="{StaticResource HeaderColumn}"
                                 Foreground="#227722" Text="ASCII" />
                    </Grid>

                    <Rectangle Grid.Row="0" Height="1" Fill="#CCC" VerticalAlignment="Bottom" />

                    <ScrollViewer Grid.Row="1" x:Name="DumpScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColOffset" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColSep1" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColHex" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColSep2" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColAscii" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OffsetBox" Grid.Column="0" Style="{StaticResource DumpColumn}"
                                     Foreground="#0066AA" />
                            <Rectangle Grid.Column="1" Width="1" Fill="#E0E0E0" VerticalAlignment="Stretch" />
                            <TextBox x:Name="HexBox" Grid.Column="2" Style="{StaticResource DumpColumn}" />
                            <Rectangle Grid.Column="3" Width="1" Fill="#E0E0E0" VerticalAlignment="Stretch" />
                            <TextBox x:Name="AsciiBox" Grid.Column="4" Style="{StaticResource DumpColumn}"
                                     Foreground="#227722" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ScrollViewer>
        </Border>

        <StatusBar Grid.Row="3" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
